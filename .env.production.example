# Production: Supabase database + Storage, real SMTP and HTTPS.
# Generate independent keys. Existing encrypted data requires its original keys.
# Download your project's CA to secrets/supabase-prod-ca.crt (Supabase Database Settings).
AFFILIATE_ENABLED="true"
AFFILIATE_ENCRYPTION_KEY="replace-with-separate-base64-32-byte-key"
AFFILIATE_ENVIRONMENT="LIVE"
API_INTERNAL_BASE_URL="http://api:4000/api/v1"
API_PORT="4000"
API_PUBLIC_URL="https://shop.example.com"
APP_VERSION="production"
ARGON2_MEMORY_KIB="65536"
ARGON2_PARALLELISM="1"
ARGON2_TIME_COST="3"
AUTH_REFRESH_TTL_DAYS="7"
DATABASE_URL="postgresql://rephone_runtime.project-ref:replace-with-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-prod-ca.crt"
DB_CONNECTION_TIMEOUT_MS="5000"
DB_IDLE_TIMEOUT_MS="10000"
DB_POOL_MAX="5"
DEALER_ENABLED="true"
DEALER_ENCRYPTION_KEY="replace-with-separate-base64-32-byte-key"
DEALER_ENVIRONMENT="LIVE"
DEALER_WORKER_ENABLED="true"
DIRECT_URL="postgresql://postgres.project-ref:replace-with-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-prod-ca.crt"
EMPLOYEE_INVITE_TTL_HOURS="24"
GUEST_CART_TTL_DAYS="30"
IDENTIFIER_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
IDENTIFIER_HMAC_KEY="replace-with-another-base64-32-byte-key"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL_SECONDS="900"
JWT_AUDIENCE="rephone-web"
JWT_ISSUER="rephone-api"
LOG_LEVEL="info"
MAIL_FROM="rePhone <no-reply@example.com>"
NEXT_PUBLIC_API_BASE_URL="/api/v1"
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL="https://www.facebook.com/rephone.vn"
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL="https://www.instagram.com/rephone.vn"
NEXT_PUBLIC_SOCIAL_TIKTOK_URL="https://www.tiktok.com/@rephone.vn"
NEXT_PUBLIC_STORE_EMAIL="hello@rephone.vn"
NODE_ENV="production"
PASSWORD_RESET_TTL_MINUTES="30"
REPHONE_RUNTIME_DB_PASSWORD="replace-with-a-long-random-database-password"
REQUEST_BODY_LIMIT="1mb"
SCHEDULER_AUTH_CLEANUP_BATCH_SIZE="500"
SCHEDULER_BATCH_SIZE="100"
SCHEDULER_ENABLED="true"
SCHEDULER_GUEST_CART_BATCH_SIZE="200"
SIGNED_URL_TTL_SECONDS="300"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_REQUIRE_TLS="true"
SMTP_SECURE="false"
SUPABASE_PRIVATE_BUCKET="rephone-private"
SUPABASE_PUBLIC_BUCKET="rephone-public"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORE_BUCKET="rephone-store-assets"
SUPABASE_URL="https://example.supabase.co"
TRUST_PROXY="true"
WEB_ORIGIN="https://shop.example.com"
WEB_PUBLIC_URL="https://shop.example.com"
SITE_DOMAIN="shop.example.com"
CADDY_ACME_EMAIL="admin@example.com"
SMTP_USER="replace-with-smtp-user"
SMTP_PASSWORD="replace-with-smtp-password"

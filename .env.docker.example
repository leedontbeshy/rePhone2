# Copy this file to .env.docker for local Docker runs. Do not commit the copy.
# Production should inject these values from a protected --env-file or secret store.

APP_VERSION=dev
GATEWAY_PORT=3000
MAILPIT_UI_PORT=8025
# Dev only: lets the API running on the host reach Mailpit over SMTP.
MAILPIT_SMTP_PORT=1025
POSTGRES_TEST_HOST_PORT=5433

# Supabase PostgreSQL. Use the least-privilege runtime role for DATABASE_URL.
DATABASE_URL=postgresql://rephone_runtime.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
# Used only by the explicit migrate job; never passed to the running API container.
DIRECT_URL=postgresql://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
# Used only by the explicit provision-runtime job. It is never passed to api/schema-check.
REPHONE_RUNTIME_DB_PASSWORD=replace-with-a-long-random-database-password
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000

# Production: download the Supabase database CA to this host path, mount it read-only,
# and use sslmode=verify-full&sslrootcert=/run/secrets/supabase-db-ca.crt in both URLs.
SUPABASE_DB_CA_FILE=./secrets/supabase-prod-ca.crt

JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=rephone-api
JWT_AUDIENCE=rephone-web
AUTH_REFRESH_TTL_DAYS=7
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
PASSWORD_RESET_TTL_MINUTES=30
EMPLOYEE_INVITE_TTL_HOURS=24
GUEST_CART_TTL_DAYS=30

# Existing databases must retain their current keys. Rotating either value requires a planned
# re-encryption/HMAC migration; replacing it directly makes stored identifiers unreadable.
# For a brand-new database, generate two different random base64 values. The encryption key
# must decode to exactly 32 bytes.
IDENTIFIER_ENCRYPTION_KEY=replace-with-a-32-byte-base64-value

# Prepare backend once; opening/pausing new dealer business is controlled in backoffice.
DEALER_ENABLED=false
DEALER_SANDBOX_WEB_URL=
DEALER_SANDBOX_API_URL=
DEALER_LIVE_WEB_URL=
DEALER_ENVIRONMENT=LIVE
DEALER_WORKER_ENABLED=true
DEALER_ENCRYPTION_KEY=
AFFILIATE_ENABLED=false
AFFILIATE_ENVIRONMENT=LIVE
AFFILIATE_ENCRYPTION_KEY=
IDENTIFIER_HMAC_KEY=replace-with-a-different-base64-value

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-production-service-role-key
SUPABASE_PUBLIC_BUCKET=rephone-public
SUPABASE_PRIVATE_BUCKET=rephone-private
SUPABASE_STORE_BUCKET=rephone-store-assets
SIGNED_URL_TTL_SECONDS=300

# Local dev/demo overrides SMTP_HOST and SMTP_PORT to the internal Mailpit service.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=rePhone <no-reply@rephone.example.com>

LOG_LEVEL=info
SCHEDULER_ENABLED=true
SCHEDULER_BATCH_SIZE=100
SCHEDULER_GUEST_CART_BATCH_SIZE=200
SCHEDULER_AUTH_CLEANUP_BATCH_SIZE=500
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=true

NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_BASE_URL=http://api:4000/api/v1
NEXT_PUBLIC_STORE_EMAIL=hello@rephone.vn
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/rephone.vn
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/rephone.vn
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@rephone.vn

# VPS / production only.
SITE_DOMAIN=rephone.example.com
CADDY_ACME_EMAIL=admin@rephone.example.com
API_IMAGE=registry.example.com/rephone/api:latest
API_OPS_IMAGE=registry.example.com/rephone/api-ops:latest
WEB_IMAGE=registry.example.com/rephone/web:latest
PULL_POLICY=missing
API_MEMORY_LIMIT=1G
WEB_MEMORY_LIMIT=768M

# Demo seed only, used by an explicit operations command (never automatic in LIVE).
SEED_ADMIN_EMAIL=admin@rephone.local
SEED_ADMIN_PASSWORD=AdminDemo123
SEED_EMPLOYEE_EMAIL=employee@rephone.local
SEED_EMPLOYEE_PASSWORD=EmployeeDemo123
SEED_CUSTOMER_EMAIL=customer@rephone.local
SEED_CUSTOMER_PASSWORD=CustomerDemo123
SEED_DEMO_PHONE=0900000000

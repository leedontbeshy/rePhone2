{
  "name": "rephone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "cross-env NODE_ENV=production turbo run build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/verify.mjs",
    "test": "turbo run test && node --test scripts/*.spec.mjs",
    "test:integration": "node scripts/test.mjs integration",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:browser": "node scripts/test.mjs browser",
    "test:coverage": "node scripts/test.mjs coverage",
    "test:performance": "node scripts/test.mjs performance",
    "db:generate": "pnpm --filter @rephone/api db:generate",
    "db:migrate": "pnpm --filter @rephone/api db:migrate",
    "db:deploy": "pnpm --filter @rephone/api db:deploy",
    "db:seed": "pnpm --filter @rephone/api db:seed",
    "db:check": "pnpm --filter @rephone/api db:check",
    "db:provision-runtime": "pnpm --filter @rephone/api db:provision-runtime",
    "demo:prepare": "pnpm --filter @rephone/api exec tsx prisma/scripts/deploy-demo.ts prepare",
    "demo:rehearse": "pnpm --filter @rephone/api exec tsx prisma/scripts/deploy-demo.ts rehearse",
    "demo:apply": "pnpm --filter @rephone/api exec tsx prisma/scripts/deploy-demo.ts apply",
    "demo:status": "pnpm --filter @rephone/api exec tsx prisma/scripts/deploy-demo.ts status",
    "api:generate": "node scripts/generate-api.mjs",
    "docker:dev": "docker compose --profile dev up --build --watch",
    "docker:prod": "docker compose --env-file .env.production --profile prod up --build -d",
    "docker:test": "node scripts/test.mjs docker",
    "postinstall": "pnpm db:generate && pnpm --filter @rephone/api-client build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@rephone/eslint-config": "workspace:*",
    "@types/node": "^24.13.3",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}

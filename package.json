{
  "name": "rephone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rephone/api --filter @rephone/web dev",
    "dev:turbo": "turbo run dev",
    "build": "cross-env NODE_ENV=production turbo run build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/*.spec.mjs",
    "test:integration": "pnpm --filter @rephone/api test:integration",
    "test:e2e": "pnpm --filter @rephone/api test:e2e",
    "test:coverage": "pnpm --filter @rephone/api test:coverage",
    "api:openapi": "pnpm --filter @rephone/api openapi",
    "api:client": "pnpm --filter @rephone/api-client generate",
    "db:generate": "pnpm --filter @rephone/api db:generate",
    "db:migrate": "pnpm --filter @rephone/api db:migrate",
    "db:deploy": "pnpm --filter @rephone/api db:deploy",
    "db:seed": "pnpm --filter @rephone/api db:seed",
    "storage:seed:catalog": "pnpm --filter @rephone/api storage:seed:catalog",
    "preflight:slice06": "pnpm --filter @rephone/api preflight:slice06",
    "preflight:slice07": "pnpm --filter @rephone/api preflight:slice07",
    "preflight:slice08": "pnpm --filter @rephone/api preflight:slice08",
    "preflight:slice09": "pnpm --filter @rephone/api preflight:slice09",
    "preflight:slice10": "pnpm --filter @rephone/api preflight:slice10",
    "preflight:slice11": "pnpm --filter @rephone/api preflight:slice11",
    "preflight:slice12": "pnpm --filter @rephone/api preflight:slice12",
    "preflight:release": "pnpm --filter @rephone/api preflight:release",
    "smoke:slice05": "pnpm --filter @rephone/api smoke:slice05",
    "smoke:slice06": "pnpm --filter @rephone/api smoke:slice06",
    "smoke:slice07": "pnpm --filter @rephone/api smoke:slice07",
    "smoke:slice08": "pnpm --filter @rephone/api smoke:slice08",
    "smoke:slice09": "pnpm --filter @rephone/api smoke:slice09",
    "smoke:slice10": "pnpm --filter @rephone/api smoke:slice10",
    "smoke:slice11": "pnpm --filter @rephone/api smoke:slice11",
    "smoke:slice12": "pnpm --filter @rephone/api smoke:slice12",
    "demo:refund-processing": "pnpm --filter @rephone/api demo:refund-processing",
    "demo:after-sales-inspecting": "pnpm --filter @rephone/api demo:after-sales-inspecting",
    "demo:scenarios": "pnpm --filter @rephone/api demo:scenarios",
    "assets:fetch:rich-models": "pnpm --filter @rephone/api assets:fetch:rich-models",
    "demo:catalog:rich": "pnpm --filter @rephone/api demo:catalog:rich",
    "db:studio": "pnpm --filter @rephone/api db:studio",
    "db:reset": "pnpm --filter @rephone/api db:reset",
    "test:db:up": "docker compose --profile test up -d postgres-test",
    "test:db:down": "docker compose --profile test stop postgres-test",
    "test:db:prepare": "pnpm --filter @rephone/api test:db:prepare",
    "test:browser:build": "cross-env NODE_ENV=production NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api/v1 API_INTERNAL_BASE_URL=http://localhost:4001/api/v1 NEXT_PUBLIC_STORE_EMAIL=hello@rephone.vn NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/rephone.vn NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/rephone.vn NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@rephone.vn pnpm --filter @rephone/web build",
    "test:browser": "playwright test",
    "test:browser:pr-smoke": "playwright test tests/browser/release-matrix.spec.ts tests/browser/backoffice-access.spec.ts tests/browser/critical-commerce-flow.spec.ts --grep \"skip-links-and-axe|anonymous-fail-closed|catalog-to-completed-shipping\"",
    "test:browser:release-matrix": "playwright test tests/browser/release-matrix.spec.ts",
    "test:browser:cross-browser-smoke": "playwright test tests/browser/release-matrix.spec.ts -g skip-links-and-axe --config playwright.cross-browser.config.ts",
    "verify:browser-artifacts": "node scripts/verify-playwright-shared-report.mjs .local/playwright-report .local/playwright-cross-browser-report",
    "performance:storefront:build": "pnpm test:browser:build",
    "performance:storefront": "pnpm performance:storefront:build && playwright test tests/performance/storefront-performance.spec.ts --config playwright.performance.config.ts",
    "performance:release": "pnpm performance:storefront:build && playwright test tests/performance/release-performance.spec.ts --config playwright.performance.config.ts",
    "performance:audit-client-media": "node scripts/fe09-client-media-audit.mjs",
    "performance:compare": "node scripts/fe09-compare-performance.mjs",
    "docker:dev": "docker compose --env-file .env.docker -f compose.yaml -f compose.dev.yaml up --build --watch",
    "docker:dev:down": "docker compose --env-file .env.docker -f compose.yaml -f compose.dev.yaml down",
    "docker:demo": "docker compose --env-file .env.docker -f compose.yaml -f compose.demo.yaml up --build -d --wait",
    "docker:demo:down": "docker compose --env-file .env.docker -f compose.yaml -f compose.demo.yaml down",
    "docker:demo:logs": "docker compose --env-file .env.docker -f compose.yaml -f compose.demo.yaml logs --follow --tail 200",
    "docker:db:check": "docker compose --env-file .env.docker -f compose.yaml -f compose.demo.yaml run --build --rm schema-check",
    "docker:db:migrate": "docker compose --env-file .env.docker -f compose.yaml -f compose.demo.yaml --profile tools run --build --rm migrate",
    "docker:db:provision-runtime": "docker compose --env-file .env.docker -f compose.yaml -f compose.demo.yaml --profile tools run --build --rm provision-runtime",
    "docker:test": "docker compose -f compose.yaml -f compose.test.yaml --profile test run --build --rm api-test",
    "fe:coverage": "pnpm --filter @rephone/web test:coverage-contract",
    "fe:a11y": "pnpm --filter @rephone/web test:a11y-contract",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:db:prepare && pnpm test:integration && pnpm test:e2e && pnpm api:openapi && pnpm api:client && pnpm build",
    "verify:generated": "git diff --exit-code -- apps/api/openapi/openapi.json packages/api-client/src/schema.d.ts",
    "verify:release:once": "pnpm verify && pnpm verify:generated && pnpm test:coverage && pnpm test:browser",
    "verify:release": "node scripts/run-release-verification.mjs",
    "postinstall": "pnpm db:generate && pnpm --filter @rephone/api-client build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@rephone/eslint-config": "workspace:*",
    "@types/node": "^24.13.3",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}

{
  "name": "@rephone/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint app components lib --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage-contract": "vitest run lib/frontend-coverage.spec.ts",
    "test:a11y-contract": "vitest run components/ui/foundation.spec.ts components/ui/foundation-render.spec.tsx components/shells/shell-utils.spec.ts components/shells/shell-foundation.spec.tsx"
  },
  "dependencies": {
    "@rephone/api-client": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

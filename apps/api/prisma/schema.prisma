  sourceCartId              String?                   @unique @map("source_cart_id") @db.Uuid
  customerId                String?                   @map("customer_id") @db.Uuid
  guestAccessTokenHash      String?                   @map("guest_access_token_hash") @db.Char(64)
  customerName              String                    @map("customer_name") @db.VarChar(255)

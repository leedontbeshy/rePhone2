  proposedAmount    Decimal               @map("proposed_amount") @db.Decimal(15, 0)
  reason            String                @db.Text
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(128)
  openedById        String                @map("opened_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt        DateTime?             @map("resolved_at") @db.Timestamptz(3)
  resolvedById      String?               @map("resolved_by_id") @db.Uuid
  resolutionNote    String?               @map("resolution_note") @db.Text

  @@index([bankTransactionId, resolvedAt])
  @@map("dealer_reconciliation_cases")
}

model DealerBankCorrection {
  id                String                @id @default(uuid(7)) @db.Uuid
  bankTransactionId String                @map("bank_transaction_id") @db.Uuid
  bankTransaction   DealerBankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  amount            Decimal               @db.Decimal(15, 0)
  reason            String                @db.Text
  actorUserId       String                @map("actor_user_id") @db.Uuid
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(128)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("dealer_bank_corrections")
}

model DealerPaymentAllocation {
  id                String                     @id @default(uuid(7)) @db.Uuid
  bankTransactionId String                     @map("bank_transaction_id") @db.Uuid
  bankTransaction   DealerBankTransaction      @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  orderId           String                     @map("order_id") @db.Uuid
  order             Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentRequestId  String                     @map("payment_request_id") @db.Uuid
  paymentRequest    DealerPaymentRequest       @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  amount            Decimal                    @db.Decimal(15, 0)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  reversals         DealerAllocationReversal[]
  refundSources     DealerRefundSource[]

  @@index([orderId])
  @@index([bankTransactionId])
  @@map("dealer_payment_allocations")
}

model DealerAllocationReversal {
  id           String                  @id @default(uuid(7)) @db.Uuid
  allocationId String                  @map("allocation_id") @db.Uuid
  allocation   DealerPaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  amount       Decimal                 @db.Decimal(15, 0)
  reason       String                  @db.Text
  actorUserId  String                  @map("actor_user_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("dealer_allocation_reversals")
}

model DealerRefundSource {
  id                String                   @id @default(uuid(7)) @db.Uuid
  refundId          String                   @map("refund_id") @db.Uuid
  refund            Refund                   @relation(fields: [refundId], references: [id], onDelete: Restrict)
  allocationId      String?                  @map("allocation_id") @db.Uuid
  allocation        DealerPaymentAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  bankTransactionId String?                  @map("bank_transaction_id") @db.Uuid
  bankTransaction   DealerBankTransaction?   @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  amount            Decimal                  @db.Decimal(15, 0)

  @@unique([refundId, allocationId])
  @@unique([refundId])
  @@unique([refundId, bankTransactionId])
  @@index([allocationId])
  @@index([bankTransactionId])
  @@map("dealer_refund_sources")
}

model DealerApiClient {
  id          String        @id @default(uuid(7)) @db.Uuid
  dealerId    String        @map("dealer_id") @db.Uuid
  dealer      DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  name        String        @db.VarChar(100)
  keyHash     String        @unique @map("key_hash") @db.Char(64)
  keyPrefix   String        @map("key_prefix") @db.VarChar(32)
  environment String        @db.VarChar(4)
  scopes      String[]
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  audits      AuditLog[]

  @@index([dealerId, revokedAt])
  @@map("dealer_api_clients")
}

model DealerIdempotencyRecord {
  id               String        @id @default(uuid(7)) @db.Uuid
  dealerId         String        @map("dealer_id") @db.Uuid
  dealer           DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  operation        String        @db.VarChar(100)
  keyHash          String        @map("key_hash") @db.Char(64)
  payloadHash      String        @map("payload_hash") @db.Char(64)
  resourceId       String        @map("resource_id") @db.Uuid
  responseSnapshot Json?         @map("response_snapshot") @db.JsonB
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([dealerId, operation, keyHash])
  @@map("dealer_idempotency_records")
}

model DealerRateLimit {
  key         String   @id @db.VarChar(255)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(1)

  @@map("dealer_rate_limits")
}

model DealerCatalogRevision {
  key     String @id @default("GLOBAL") @db.VarChar(32)
  version Int    @default(1)

  @@map("dealer_catalog_revision")
}

model DealerWebhookEndpoint {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  dealerId                 String                  @map("dealer_id") @db.Uuid
  dealer                   DealerProfile           @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  url                      String                  @db.Text
  enabled                  Boolean                 @default(true)
  secretCiphertext         String                  @map("secret_ciphertext") @db.Text
  keyId                    String                  @map("key_id") @db.Uuid
  previousSecretCiphertext String?                 @map("previous_secret_ciphertext") @db.Text
  previousKeyId            String?                 @map("previous_key_id") @db.Uuid
  previousValidUntil       DateTime?               @map("previous_valid_until") @db.Timestamptz(3)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveries               DealerWebhookDelivery[]

  @@index([dealerId, enabled])
  @@map("dealer_webhook_endpoints")
}

model DealerOutboxEvent {
  id              String                  @id @default(uuid(7)) @db.Uuid
  dealerId        String                  @map("dealer_id") @db.Uuid
  dealer          DealerProfile           @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  eventType       String                  @map("event_type") @db.VarChar(100)
  resourceType    String                  @map("resource_type") @db.VarChar(32)
  resourceId      String                  @map("resource_id") @db.VarChar(64)
  resourceVersion Int                     @map("resource_version")
  data            Json                    @db.JsonB
  occurredAt      DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(3)
  expandedAt      DateTime?               @map("expanded_at") @db.Timestamptz(3)
  deliveries      DealerWebhookDelivery[]

  @@index([expandedAt, occurredAt])
  @@index([dealerId, occurredAt])
  @@index([resourceType, resourceId, resourceVersion], map: "dealer_outbox_resource_idx")
  @@map("dealer_outbox_events")
}

model DealerWebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  eventId        String                @map("event_id") @db.Uuid
  event          DealerOutboxEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  endpointId     String                @map("endpoint_id") @db.Uuid
  endpoint       DealerWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  attempts       Int                   @default(0)
  dueAt          DateTime              @default(now()) @map("due_at") @db.Timestamptz(3)
  leaseUntil     DateTime?             @map("lease_until") @db.Timestamptz(3)
  leaseToken     String?               @map("lease_token") @db.Uuid
  status         String                @default("PENDING") @db.VarChar(16)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error") @db.VarChar(100)
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(3)

  @@unique([eventId, endpointId])
  @@index([status, dueAt])
  @@map("dealer_webhook_deliveries")
}

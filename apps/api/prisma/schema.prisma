generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  EMPLOYEE_INVITATION
}

enum ProductType {
  IPHONE
  ACCESSORY
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMode {
  SERIALIZED
  QUANTITY
}

enum LocationType {
  STORE
  WAREHOUSE
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum SimLockStatus {
  UNLOCKED
  CARRIER_LOCKED
  UNKNOWN
}

enum SimConfiguration {
  SINGLE_PHYSICAL
  DUAL_PHYSICAL
  PHYSICAL_AND_ESIM
  ESIM_ONLY
  UNKNOWN
}

enum InventoryLifecycleStatus {
  RECEIVED
  INSPECTING
  AVAILABLE
  IN_TRANSIT
  SOLD
  REPAIRING
  QUARANTINED
  WRITTEN_OFF
}

enum InspectionType {
  INTAKE
  RETURN
  WARRANTY
  PRE_SALE
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum BatteryReplacementStatus {
  ORIGINAL
  REPLACED
  UNKNOWN
}

enum ConditionGrade {
  A
  B
  C
}

enum RepairHistoryStatus {
  NONE_KNOWN
  KNOWN
  UNKNOWN
}

enum InspectionResult {
  INCOMPLETE
  PASSED
  PARTIAL
  FAILED
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WRITE_OFF
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum ReservationReason {
  DEPOSIT
  REVIEW
  PICKUP
  FULFILLMENT
  DEALER_PAYMENT
  DEALER_BALANCE
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum VoucherVisibility {
  PUBLIC
  ACCOUNT_ONLY
}

enum VoucherScopeType {
  ORDER
  PRODUCT_TYPE
  PRODUCTS
  VARIANTS
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum VoucherUsageStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  SHIPPING
}

enum FulfillmentStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  COMPLETED
  FAILED
  RETURNED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL_PAYMENT
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  COD
  OTHER
}

enum PaymentStatus {
  AWAITING_PROOF
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RefundMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum RefundRequesterType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum ShipmentStatus {
  CREATED
  HANDED_TO_CARRIER
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum WarrantyStatus {
  ACTIVE
  VOIDED
}

enum AfterSalesType {
  WARRANTY
  RETURN
  EXCHANGE
}

enum AfterSalesStatus {
  REQUESTED
  RECEIVED
  INSPECTING
  APPROVED
  REJECTED
  RESOLVED
  CANCELLED
}

enum AfterSalesResolution {
  REPAIRED
  REPLACED
  REFUNDED
  RETURNED_UNCHANGED
  OTHER
}

enum AuditActorType {
  USER
  GUEST
  SYSTEM
  API_CLIENT
}

enum OrderChannel {
  STOREFRONT
  DEALER
}

enum DealerBusinessStatus {
  PENDING
  ACTIVE
  REJECTED
  BUSINESS_SUSPENDED
  CLOSED
}

enum DealerSecurityStatus {
  NORMAL
  SECURITY_LOCKED
}

enum DealerRequestStatus {
  OPEN
  SATISFIED
  SUPERSEDED
  EXPIRED
  CANCELLED
}

enum DealerProofStatus {
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CANCELLED
}

model AffiliatePolicy {
  key           String   @id @default("GLOBAL") @db.VarChar(16)
  enabled       Boolean  @default(false)
  rateBps       Int?     @map("rate_bps")
  reserveAmount Decimal? @map("reserve_amount") @db.Decimal(15, 0)
  minimumProfit Decimal? @map("minimum_profit") @db.Decimal(15, 0)
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("affiliate_policies")
}

model AffiliateProfile {
  id                String                 @id @default(uuid(7)) @db.Uuid
  ownerUserId       String                 @unique @map("owner_user_id") @db.Uuid
  owner             User                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  code              String                 @unique @db.VarChar(24)
  displayName       String                 @map("display_name") @db.VarChar(120)
  phone             String                 @db.VarChar(32)
  promotionChannels String                 @map("promotion_channels") @db.VarChar(1000)
  termsVersion      String                 @map("terms_version") @db.VarChar(40)
  termsAcceptedAt   DateTime               @map("terms_accepted_at") @db.Timestamptz(3)
  status            String                 @default("PENDING") @db.VarChar(20)
  reason            String?                @db.Text
  payoutHold        Boolean                @default(false) @map("payout_hold")
  version           Int                    @default(1)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  banks             AffiliateBankAccount[]
  referrals         AffiliateReferral[]
  attributions      AffiliateAttribution[]
  payouts           AffiliatePayout[]

  @@map("affiliate_profiles")
}

model AffiliateInventoryOverride {
  inventoryUnitId String        @id @map("inventory_unit_id") @db.Uuid
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  enabled         Boolean       @default(true)
  rateBps         Int?          @map("rate_bps")
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("affiliate_inventory_overrides")
}

model AffiliateBankAccount {
  id                    String            @id @default(uuid(7)) @db.Uuid
  affiliateId           String            @map("affiliate_id") @db.Uuid
  affiliate             AffiliateProfile  @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  bankName              String            @map("bank_name") @db.VarChar(120)
  accountHolder         String            @map("account_holder") @db.VarChar(120)
  accountCiphertext     String            @map("account_ciphertext") @db.Text
  accountFingerprint    String            @map("account_fingerprint") @db.Char(64)
  lastFour              String            @map("last_four") @db.VarChar(4)
  confirmationHash      String?           @unique @map("confirmation_hash") @db.Char(64)
  confirmationExpiresAt DateTime?         @map("confirmation_expires_at") @db.Timestamptz(3)
  confirmationSentAt    DateTime?         @map("confirmation_sent_at") @db.Timestamptz(3)
  emailConfirmedAt      DateTime?         @map("email_confirmed_at") @db.Timestamptz(3)
  verifiedAt            DateTime?         @map("verified_at") @db.Timestamptz(3)
  effectiveAt           DateTime?         @map("effective_at") @db.Timestamptz(3)
  disabledAt            DateTime?         @map("disabled_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  payouts               AffiliatePayout[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_bank_accounts")
}

model AffiliateReferral {
  id          String           @id @default(uuid(7)) @db.Uuid
  affiliateId String           @map("affiliate_id") @db.Uuid
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  tokenHash   String           @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)

  @@index([affiliateId, createdAt])
  @@index([expiresAt])
  @@map("affiliate_referrals")
}

model AffiliateAttribution {
  orderId       String                @id @map("order_id") @db.Uuid
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  affiliateId   String                @map("affiliate_id") @db.Uuid
  affiliate     AffiliateProfile      @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  referredAt    DateTime              @map("referred_at") @db.Timestamptz(3)
  policyVersion Int                   @map("policy_version")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  commissions   AffiliateCommission[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_attributions")
}

model AffiliateCommission {
  id             String                @id @default(uuid(7)) @db.Uuid
  orderId        String                @map("order_id") @db.Uuid
  attribution    AffiliateAttribution  @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  orderItemId    String                @unique @map("order_item_id") @db.Uuid
  orderItem      OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  rateBps        Int                   @map("rate_bps")
  baseAmount     Decimal               @map("base_amount") @db.Decimal(15, 0)
  floorAmount    Decimal               @map("floor_amount") @db.Decimal(15, 0)
  originalAmount Decimal               @map("original_amount") @db.Decimal(15, 0)
  amount         Decimal               @db.Decimal(15, 0)
  paidAmount     Decimal               @default(0) @map("paid_amount") @db.Decimal(15, 0)
  absorbedLoss   Decimal               @default(0) @map("absorbed_loss") @db.Decimal(15, 0)
  status         String                @default("PENDING") @db.VarChar(20)
  holdReason     String?               @map("hold_reason") @db.VarChar(120)
  availableAt    DateTime?             @map("available_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  adjustments    AffiliateAdjustment[]
  payoutItems    AffiliatePayoutItem[]

  @@index([orderId])
  @@index([status, availableAt])
  @@map("affiliate_commissions")
}

model AffiliateAdjustment {
  id           String              @id @default(uuid(7)) @db.Uuid
  commissionId String              @map("commission_id") @db.Uuid
  commission   AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  sourceKey    String              @unique @map("source_key") @db.VarChar(180)
  amount       Decimal             @db.Decimal(15, 0)
  reason       String              @db.VarChar(120)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("affiliate_adjustments")
}

model AffiliatePayout {
  id                String                @id @default(uuid(7)) @db.Uuid
  affiliateId       String                @map("affiliate_id") @db.Uuid
  affiliate         AffiliateProfile      @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  bankAccountId     String                @map("bank_account_id") @db.Uuid
  bankAccount       AffiliateBankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankSnapshot      Json                  @map("bank_snapshot") @db.JsonB
  requestKey        String                @map("request_key") @db.VarChar(100)
  amount            Decimal               @db.Decimal(15, 0)
  status            String                @default("REQUESTED") @db.VarChar(20)
  note              String?               @db.Text
  transferReference String?               @unique @map("transfer_reference") @db.VarChar(150)
  evidence          Json?                 @db.JsonB
  transferredAt     DateTime?             @map("transferred_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  items             AffiliatePayoutItem[]

  @@unique([affiliateId, requestKey])
  @@index([status, createdAt])
  @@map("affiliate_payouts")
}

model AffiliatePayoutItem {
  id           String              @id @default(uuid(7)) @db.Uuid
  payoutId     String              @map("payout_id") @db.Uuid
  payout       AffiliatePayout     @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  commissionId String              @map("commission_id") @db.Uuid
  commission   AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  amount       Decimal             @db.Decimal(15, 0)
  active       Boolean             @default(true)

  @@unique([payoutId, commissionId])
  @@map("affiliate_payout_items")
}

model User {
  affiliateProfile           AffiliateProfile?
  dealerProfile              DealerProfile?
  id                         String                @id @default(uuid(7)) @db.Uuid
  email                      String                @db.VarChar(320)
  normalizedEmail            String                @unique @map("normalized_email") @db.VarChar(320)
  passwordHash               String?               @map("password_hash") @db.Text
  role                       UserRole
  status                     UserStatus
  fullName                   String                @map("full_name") @db.VarChar(255)
  phone                      String?               @db.VarChar(32)
  employeeCode               String?               @unique @map("employee_code") @db.VarChar(64)
  hiredAt                    DateTime?             @map("hired_at") @db.Date
  emailVerifiedAt            DateTime?             @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt          DateTime?             @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt                DateTime?             @map("last_login_at") @db.Timestamptz(3)
  suspendedAt                DateTime?             @map("suspended_at") @db.Timestamptz(3)
  disabledAt                 DateTime?             @map("disabled_at") @db.Timestamptz(3)
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  addresses                  CustomerAddress[]
  authSessions               AuthSession[]
  authTokens                 AuthToken[]
  carts                      Cart[]
  wishlistItems              WishlistItem[]
  voucherUsages              VoucherUsage[]
  orders                     Order[]               @relation("OrderCustomer")
  shippingFeeOverrides       Order[]               @relation("OrderShippingFeeOverriddenBy")
  inspections                InventoryInspection[] @relation("InspectionInspector")
  stockMovements             StockMovement[]       @relation("StockMovementCreator")
  paymentReviews             Payment[]             @relation("PaymentReviewer")
  requestedRefunds           Refund[]              @relation("RefundRequester")
  processedRefunds           Refund[]              @relation("RefundProcessor")
  terminalRefunds            Refund[]              @relation("RefundTerminalActor")
  shipmentsCreated           Shipment[]            @relation("ShipmentCreator")
  warranties                 Warranty[]            @relation("WarrantyCustomer")
  warrantiesVoided           Warranty[]            @relation("WarrantyVoidedBy")
  afterSalesRequests         AfterSalesRequest[]   @relation("AfterSalesCustomer")
  assignedAfterSalesRequests AfterSalesRequest[]   @relation("AfterSalesAssignee")
  receivedAfterSalesRequests AfterSalesRequest[]   @relation("AfterSalesReceiver")
  decidedAfterSalesRequests  AfterSalesRequest[]   @relation("AfterSalesDecider")
  resolvedAfterSalesRequests AfterSalesRequest[]   @relation("AfterSalesResolver")
  settingsUpdates            StoreSettings[]       @relation("SettingsUpdatedBy")
  auditLogs                  AuditLog[]            @relation("AuditActor")

  @@index([role, status, createdAt])
  @@map("users")
}

model CustomerAddress {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  label        String?   @db.VarChar(255)
  receiverName String    @map("receiver_name") @db.VarChar(255)
  phone        String    @db.VarChar(32)
  addressLine  String    @map("address_line") @db.VarChar(255)
  ward         String    @db.VarChar(255)
  district     String    @db.VarChar(255)
  province     String    @db.VarChar(255)
  postalCode   String?   @map("postal_code") @db.VarChar(32)
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("customer_addresses")
}

model AuthSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId, revokedAt])
  @@index([expiresAt, id])
  @@map("auth_sessions")
}

model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt, id])
  @@map("auth_tokens")
}

model Product {
  id               String           @id @default(uuid(7)) @db.Uuid
  type             ProductType
  brand            String           @default("Apple") @db.VarChar(255)
  name             String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(180)
  description      String?          @db.Text
  status           CatalogStatus    @default(DRAFT)
  releaseYear      Int?             @map("release_year")
  chipset          String?          @db.VarChar(255)
  ramGb            Int?             @map("ram_gb")
  screenSizeInches Decimal?         @map("screen_size_inches") @db.Decimal(4, 2)
  warrantyPolicyId String?          @map("warranty_policy_id") @db.Uuid
  seoTitle         String?          @map("seo_title") @db.VarChar(255)
  seoDescription   String?          @map("seo_description") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  warrantyPolicy   WarrantyPolicy?  @relation("ProductWarrantyPolicy", fields: [warrantyPolicyId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  media            ProductMedia[]
  orderItems       OrderItem[]

  @@index([status, type, createdAt])
  @@index([warrantyPolicyId])
  @@map("products")
}

model ProductVariant {
  id                  String          @id @default(uuid(7)) @db.Uuid
  productId           String          @map("product_id") @db.Uuid
  sku                 String          @unique @db.VarChar(64)
  displayName         String          @map("display_name") @db.VarChar(255)
  storageCapacityGb   Int?            @map("storage_capacity_gb")
  colorName           String?         @map("color_name") @db.VarChar(255)
  colorHex            String?         @map("color_hex") @db.VarChar(7)
  inventoryMode       InventoryMode   @map("inventory_mode")
  salePrice           Decimal?        @map("sale_price") @db.Decimal(15, 0)
  compareAtPrice      Decimal?        @map("compare_at_price") @db.Decimal(15, 0)
  accessoryAttributes Json?           @map("accessory_attributes") @db.JsonB
  warrantyPolicyId    String?         @map("warranty_policy_id") @db.Uuid
  status              CatalogStatus   @default(DRAFT)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt          DateTime?       @map("archived_at") @db.Timestamptz(3)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warrantyPolicy      WarrantyPolicy? @relation("VariantWarrantyPolicy", fields: [warrantyPolicyId], references: [id], onDelete: Restrict)
  inventoryUnits      InventoryUnit[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  media               ProductMedia[]
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  orderItems          OrderItem[]

  @@index([productId, status])
  @@index([warrantyPolicyId])
  @@map("product_variants")
}

model InventoryLocation {
  id                 String              @id @default(uuid(7)) @db.Uuid
  code               String              @unique @db.VarChar(64)
  name               String              @db.VarChar(255)
  type               LocationType
  status             ActiveStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventoryUnits     InventoryUnit[]
  stockLevels        StockLevel[]
  movementsFrom      StockMovement[]     @relation("StockMovementFromLocation")
  movementsTo        StockMovement[]     @relation("StockMovementToLocation")
  fulfillmentOrders  Order[]             @relation("OrderFulfillmentLocation")
  pickupOrders       Order[]             @relation("OrderPickupLocation")
  returnedShipments  Shipment[]          @relation("ShipmentReturnLocation")
  receivedAfterSales AfterSalesRequest[] @relation("AfterSalesReceivedLocation")

  @@map("inventory_locations")
}

model InventoryUnit {
  affiliateOverride     AffiliateInventoryOverride?
  dealerOverride        DealerInventoryOverride?
  id                    String                      @id @default(uuid(7)) @db.Uuid
  variantId             String                      @map("variant_id") @db.Uuid
  locationId            String                      @map("location_id") @db.Uuid
  inventoryCode         String                      @unique @map("inventory_code") @db.VarChar(64)
  isFeatured            Boolean                     @default(false) @map("is_featured")
  modelNumber           String?                     @map("model_number") @db.VarChar(255)
  regionCode            String?                     @map("region_code") @db.VarChar(255)
  simLockStatus         SimLockStatus               @default(UNKNOWN) @map("sim_lock_status")
  carrierName           String?                     @map("carrier_name") @db.VarChar(255)
  simConfiguration      SimConfiguration            @default(UNKNOWN) @map("sim_configuration")
  imei1Encrypted        String?                     @map("imei1_encrypted") @db.Text
  imei1Hmac             String?                     @unique @map("imei1_hmac") @db.Char(64)
  imei1Suffix           String?                     @map("imei1_suffix") @db.VarChar(8)
  imei2Encrypted        String?                     @map("imei2_encrypted") @db.Text

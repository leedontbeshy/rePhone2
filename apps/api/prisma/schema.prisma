  pickupReadyAt             DateTime?                 @map("pickup_ready_at") @db.Timestamptz(3)
  pickedUpAt                DateTime?                 @map("picked_up_at") @db.Timestamptz(3)
  status                    OrderStatus               @default(PLACED)
  paymentStatus             OrderPaymentStatus        @default(UNPAID) @map("payment_status")
  subtotal                  Decimal                   @db.Decimal(15, 0)
  itemDiscountAmount        Decimal                   @default(0) @map("item_discount_amount") @db.Decimal(15, 0)
  voucherDiscountAmount     Decimal                   @default(0) @map("voucher_discount_amount") @db.Decimal(15, 0)
  shippingFeeOriginal       Decimal                   @default(0) @map("shipping_fee_original") @db.Decimal(15, 0)
  shippingFee               Decimal                   @default(0) @map("shipping_fee") @db.Decimal(15, 0)
  shippingFeeOverrideReason String?                   @map("shipping_fee_override_reason") @db.Text
  shippingFeeOverriddenById String?                   @map("shipping_fee_overridden_by_id") @db.Uuid
  shippingFeeOverriddenAt   DateTime?                 @map("shipping_fee_overridden_at") @db.Timestamptz(3)
  grandTotal                Decimal                   @map("grand_total") @db.Decimal(15, 0)
  depositRequired           Decimal                   @default(0) @map("deposit_required") @db.Decimal(15, 0)
  paidAmount                Decimal                   @default(0) @map("paid_amount") @db.Decimal(15, 0)
  refundedAmount            Decimal                   @default(0) @map("refunded_amount") @db.Decimal(15, 0)
  balanceDue                Decimal                   @map("balance_due") @db.Decimal(15, 0)
  voucherCodeSnapshot       String?                   @map("voucher_code_snapshot") @db.VarChar(64)
  customerNote              String?                   @map("customer_note") @db.Text
  internalNote              String?                   @map("internal_note") @db.Text
  cancelReason              String?                   @map("cancel_reason") @db.Text
  placedAt                  DateTime                  @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt               DateTime?                 @map("confirmed_at") @db.Timestamptz(3)
  completedAt               DateTime?                 @map("completed_at") @db.Timestamptz(3)
  cancelledAt               DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceCart                Cart?                     @relation(fields: [sourceCartId], references: [id], onDelete: Restrict)
  customer                  User?                     @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  fulfillmentLocation       InventoryLocation         @relation("OrderFulfillmentLocation", fields: [fulfillmentLocationId], references: [id], onDelete: Restrict)
  pickupLocation            InventoryLocation?        @relation("OrderPickupLocation", fields: [pickupLocationId], references: [id], onDelete: Restrict)
  shippingFeeOverriddenBy   User?                     @relation("OrderShippingFeeOverriddenBy", fields: [shippingFeeOverriddenById], references: [id], onDelete: Restrict)
  items                     OrderItem[]
  payments                  Payment[]
  refunds                   Refund[]
  shipments                 Shipment[]
  reservations              InventoryReservation[]
  voucherUsage              VoucherUsage?

  @@unique([dealerId, externalOrderId])
  @@index([channel, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, fulfillmentStatus, createdAt(sort: Desc)])
  // Slice 08 pickup expiry queue index is migration-managed because Prisma cannot express its predicate.
  @@index([fulfillmentLocationId])
  @@index([pickupLocationId])
  @@map("orders")
}

